{
  "name": "oso-mvc-boilerplate",
  "version": "1.0.0",
  "description": "Schema-driven MVC boilerplate: Node + TypeScript + Express + Prisma + Handlebars",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "bash bin/setup.sh",
    "dev": "tsx watch src/server.ts",
    "dev:temporal-worker": "tsx watch src/temporal/worker.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-runtime-assets.mjs",
    "start": "node dist/server.js",
    "start:temporal-worker": "node dist/temporal/worker.js",
    "db:up": "docker compose -f docker-compose.yml -f compose.host.yml up -d db",
    "temporal:up": "docker compose -f docker-compose.yml -f compose.host.yml up -d temporal-postgres temporal temporal-ui",
    "temporal:down": "docker compose stop temporal-ui temporal temporal-postgres",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "css:build": "tailwindcss -i ./src/views/styles.css -o ./public/css/app.css",
    "css:watch": "tailwindcss -i ./src/views/styles.css -o ./public/css/app.css --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.typetests.json",
    "test:acceptance:browser": "node tests/acceptance/browser-acceptance-test.mjs",
    "test:acceptance:upload": "node tests/acceptance/upload-smoke-test.mjs",
    "test:acceptance": "npm run test:acceptance:browser && npm run test:acceptance:upload",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test:platform:integration": "vitest run --config vitest.platform-integration.config.ts",
    "temporal:bundle": "node scripts/temporal-bundle.mjs",
    "temporal:replay": "node scripts/temporal-replay.mjs",
    "test:platform:owned": "node scripts/run-owned-database.mjs",
    "temporal:canary": "node scripts/temporal-canary.mjs",
    "test:local:all": "npm run typecheck && npm run lint && npm run check:architecture && npm test && npm run build && npm run test:platform:owned -- --browser --temporal",
    "docker:up": "docker compose up --build -d --wait",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f web worker initialize",
    "test:docker": "node scripts/test-docker-startup.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1107.0",
    "@bull-board/api": "^8.6.0",
    "@bull-board/express": "^8.6.0",
    "@prisma/client": "^5.22.0",
    "@temporalio/activity": "^1.22.0",
    "@temporalio/client": "^1.22.0",
    "@temporalio/worker": "^1.22.0",
    "@temporalio/workflow": "^1.22.0",
    "bullmq": "^6.0.10",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-handlebars": "^8.0.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "sanitize-html": "^2.13.1",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.1",
    "@types/sanitize-html": "^2.13.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^10.8.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.5"
  }
}
