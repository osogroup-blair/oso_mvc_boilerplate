<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-semibold">Active Sessions</h1>
</div>

{{#if revoked}}
  <div class="bg-green-50 border-l-4 border-green-400 p-4 mb-6">
    <div class="flex">
      <div class="flex-shrink-0">
        <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
        </svg>
      </div>
      <div class="ml-3">
        <p class="text-sm text-green-700">Session successfully revoked.</p>
      </div>
    </div>
  </div>
{{/if}}

<form method="get" class="mb-4">
  <input type="text" name="q" value="{{query.q}}" placeholder="Search by name or email..."
    class="w-full max-w-sm rounded border border-gray-300 px-3 py-2 text-sm" />
</form>

<div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
  <table class="w-full text-sm text-left">
    <thead class="bg-gray-50 border-b border-gray-200 text-gray-500 font-medium">
      <tr>
        <th class="px-6 py-3">User</th>
        <th class="px-6 py-3">Role</th>
        <th class="px-6 py-3">Created At</th>
        <th class="px-6 py-3">Expires At</th>
        <th class="px-6 py-3 text-right">Action</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      {{#each records}}
        <tr class="hover:bg-gray-50">
          <td class="px-6 py-4">
            <div class="font-medium text-gray-900">{{this.user.name}}</div>
            <div class="text-xs text-gray-500">{{this.user.email}}</div>
          </td>
          <td class="px-6 py-4">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
              {{this.user.role.name}}
            </span>
          </td>
          <td class="px-6 py-4 text-gray-500 text-xs">
            {{this.createdAt}}
          </td>
          <td class="px-6 py-4 text-gray-500 text-xs">
            {{this.expiresAt}}
          </td>
          <td class="px-6 py-4 text-right">
            <form action="/admin/sessions/{{this.id}}/logout" method="POST" class="inline m-0" data-confirm="Are you sure you want to log this user session out?">
  <input type="hidden" name="_csrf" value="{{@root.csrfToken}}" />
  <input type="hidden" name="_operationId" value="{{@root.operationId}}" />
              <button type="submit" class="bg-red-50 hover:bg-red-100 text-red-600 hover:text-red-700 px-3 py-1.5 rounded text-xs font-semibold border border-red-200 transition-colors">
                Log Out
              </button>
            </form>
          </td>
        </tr>
      {{else}}
        <tr>
          <td class="px-6 py-8 text-center text-gray-400" colspan="5">
            No active sessions found.
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</div>

{{#if meta.totalPages}}
  <div class="flex items-center gap-2 mt-4 text-sm">
    {{#if (gt meta.page 1)}}<a href="?page={{dec meta.page}}&q={{query.q}}" class="px-3 py-1 border rounded hover:bg-gray-50">Prev</a>{{/if}}
    <span class="text-gray-500">Page {{meta.page}} of {{meta.totalPages}} · {{meta.total}} total</span>
    {{#if (lt meta.page meta.totalPages)}}<a href="?page={{inc meta.page}}&q={{query.q}}" class="px-3 py-1 border rounded hover:bg-gray-50">Next</a>{{/if}}
  </div>
{{/if}}
