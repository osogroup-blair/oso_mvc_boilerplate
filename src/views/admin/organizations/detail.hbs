<div class="space-y-6">
  <!-- Header -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between space-y-4 md:space-y-0">
    <div>
      <a href="/admin/organizations" class="text-sm text-indigo-600 hover:underline">← All Organizations</a>
      <h1 class="mt-1 text-3xl font-bold text-gray-900 tracking-tight">{{org.name}}</h1>
      <p class="mt-1 text-xs text-gray-400 font-mono">{{org.slug}}</p>
    </div>
    {{#if canDelete}}<form action="/admin/organizations/{{org.id}}/delete" method="POST"
      data-confirm="Delete this organization? This cannot be undone.">
  <input type="hidden" name="_csrf" value="{{@root.csrfToken}}" />
  <input type="hidden" name="_operationId" value="{{@root.operationId}}" />
      <button type="submit" class="inline-flex items-center gap-2 px-4 py-2 bg-red-50 text-red-700 text-sm font-semibold rounded-lg border border-red-200 hover:bg-red-100 transition-colors">
        Delete Organization
      </button>
    </form>{{/if}}
  </div>

  <!-- Flash messages -->
  {{#if query.created}}<div class="rounded-lg bg-green-50 p-3 border border-green-200 text-sm font-medium text-green-800">Organization created.</div>{{/if}}
  {{#if query.updated}}<div class="rounded-lg bg-green-50 p-3 border border-green-200 text-sm font-medium text-green-800">Settings saved.</div>{{/if}}
  {{#if query.memberAdded}}<div class="rounded-lg bg-green-50 p-3 border border-green-200 text-sm font-medium text-green-800">Member added.</div>{{/if}}
  {{#if query.memberRemoved}}<div class="rounded-lg bg-indigo-50 p-3 border border-indigo-200 text-sm font-medium text-indigo-800">Member removed.</div>{{/if}}
  {{#if query.roleChanged}}<div class="rounded-lg bg-indigo-50 p-3 border border-indigo-200 text-sm font-medium text-indigo-800">Role updated.</div>{{/if}}
  {{#if query.error}}<div class="rounded-lg bg-red-50 p-3 border border-red-200 text-sm font-medium text-red-800">{{query.error}}</div>{{/if}}

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Settings Panel -->
    <div class="lg:col-span-1 bg-white rounded-2xl border border-gray-100 shadow-sm p-6 space-y-4">
      <h2 class="text-base font-bold text-gray-900">Settings</h2>
      {{#if canManage}}<form action="/admin/organizations/{{org.id}}" method="POST" class="space-y-4">
  <input type="hidden" name="_csrf" value="{{@root.csrfToken}}" />
  <input type="hidden" name="_operationId" value="{{@root.operationId}}" />
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Name</label>
          <input name="name" value="{{org.name}}" required
            class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Logo URL</label>
          <input name="logoUrl" value="{{org.logoUrl}}" type="url" placeholder="https://..."
            class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>
        <button type="submit"
          class="w-full py-2 bg-indigo-600 text-white text-sm font-semibold rounded-lg hover:bg-indigo-700 transition-colors">
          Save Changes
        </button>
      </form>{{/if}}
    </div>

    <!-- Members Panel -->
    <div class="lg:col-span-2 bg-white rounded-2xl border border-gray-100 shadow-sm p-6 space-y-6">
      <div class="flex items-center justify-between">
        <h2 class="text-base font-bold text-gray-900">Members ({{org.members.length}})</h2>
        {{#if canManage}}
          <button data-modal-open="invite-modal"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-indigo-600 text-white text-xs font-semibold rounded-lg hover:bg-indigo-700 transition-colors">
            + Invite Member
          </button>
        {{/if}}
      </div>

      {{#if org.members.length}}
        <div class="overflow-hidden rounded-xl border border-gray-100">
          <table class="min-w-full divide-y divide-gray-100">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">User</th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Role</th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Joined</th>
                <th class="px-4 py-3"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              {{#each org.members}}
                <tr class="hover:bg-gray-50">
                  <td class="px-4 py-3">
                    <p class="text-sm font-semibold text-gray-900">{{user.name}}</p>
                    <p class="text-xs text-gray-400">{{user.email}}</p>
                  </td>
                  <td class="px-4 py-3">
                    {{#if canManageMember}}<form action="/admin/organizations/{{../org.id}}/members/{{id}}/role" method="POST" class="inline-flex items-center gap-2">
  <input type="hidden" name="_csrf" value="{{@root.csrfToken}}" />
  <input type="hidden" name="_operationId" value="{{@root.operationId}}" />
                      <select name="role" data-auto-submit
                        class="text-xs rounded-lg border border-gray-200 px-2 py-1 focus:ring-2 focus:ring-indigo-400">
                        {{#each ../orgRoles}}
                          <option value="{{this}}" {{#if (eq this ../role)}}selected{{/if}}>{{this}}</option>
                        {{/each}}
                      </select>
                    </form>{{/if}}
                  </td>
                  <td class="px-4 py-3 text-xs text-gray-400">{{joinedAt}}</td>
                  <td class="px-4 py-3 text-right">
                    {{#if canManageMember}}<form action="/admin/organizations/{{../org.id}}/members/{{id}}/remove" method="POST"
                      data-confirm="Remove this member?">
  <input type="hidden" name="_csrf" value="{{@root.csrfToken}}" />
  <input type="hidden" name="_operationId" value="{{@root.operationId}}" />
                      <button type="submit" class="text-xs text-red-500 hover:text-red-700 font-medium transition-colors">Remove</button>
                    </form>{{/if}}
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      {{else}}
        <p class="text-sm text-gray-400 text-center py-8">No members yet.</p>
      {{/if}}
    </div>
  </div>
</div>

<!-- Invite Member Modal -->
{{#if canManage}}
<div id="invite-modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md">
    <div class="px-6 py-5 border-b border-gray-100">
      <h2 class="text-lg font-bold text-gray-900">Invite Member</h2>
    </div>
    {{#if canManage}}<form action="/admin/organizations/{{org.id}}/members" method="POST" class="px-6 py-6 space-y-4">
  <input type="hidden" name="_csrf" value="{{@root.csrfToken}}" />
  <input type="hidden" name="_operationId" value="{{@root.operationId}}" />
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">User</label>
        {{#if availableUsers.length}}<select name="userId" required class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
          <option value="">Select a user...</option>
          {{#each availableUsers}}
            <option value="{{id}}">{{name}} ({{email}})</option>
          {{/each}}
        </select>{{else}}<input name="userId" required placeholder="Known user UUID" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" />{{/if}}
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Role</label>
        <select name="role" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
          {{#each orgRoles}}
            <option value="{{this}}">{{this}}</option>
          {{/each}}
        </select>
      </div>
      <div class="flex gap-3 pt-2">
        <button type="submit" class="flex-1 py-2 bg-indigo-600 text-white text-sm font-semibold rounded-lg hover:bg-indigo-700 transition-colors">Add Member</button>
        <button type="button" data-modal-close="invite-modal"
          class="flex-1 py-2 border border-gray-300 text-sm font-semibold rounded-lg text-gray-700 hover:bg-gray-50 transition-colors">Cancel</button>
      </div>
    </form>{{/if}}
  </div>
</div>
{{/if}}

