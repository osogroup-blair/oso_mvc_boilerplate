<div class="space-y-6">
  <div>
    <a href="/admin/integrations?orgId={{activeOrg.id}}" class="text-sm font-medium text-indigo-600 hover:text-indigo-700">Back to integrations</a>
    <h1 class="mt-2 text-2xl font-semibold text-gray-900">{{connection.name}}</h1>
    <p class="mt-1 font-mono text-xs text-gray-500">{{connection.providerKey}} · {{provider.label}}</p>
  </div>

  {{#if query.created}}<div class="rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">Connection created.</div>{{/if}}
  {{#if query.rotated}}<div class="rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">Credentials rotated. Run a test before relying on this connection.</div>{{/if}}
  {{#if query.disabled}}<div class="rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">Connection disabled.</div>{{/if}}
  {{#if query.message}}<div class="rounded-md border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-800">{{query.message}}</div>{{/if}}
  {{#if query.error}}<div class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{{query.error}}</div>{{/if}}

  <section class="rounded-lg border border-gray-200 bg-white p-5">
    <h2 class="text-lg font-semibold text-gray-900">Connection Status</h2>
    <dl class="mt-4 grid gap-4 md:grid-cols-2">
      <div>
        <dt class="text-xs uppercase tracking-wide text-gray-500">Status</dt>
        <dd class="mt-1 text-sm font-medium text-gray-900">{{connection.status}}</dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wide text-gray-500">Credential Fingerprint</dt>
        <dd class="mt-1 font-mono text-sm text-gray-900">{{connection.credentialFingerprint}}</dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wide text-gray-500">Last Test</dt>
        <dd class="mt-1 text-sm text-gray-900">{{connection.lastTestStatus}} {{#if connection.lastTestedAt}}· {{connection.lastTestedAt}}{{/if}}</dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wide text-gray-500">Message</dt>
        <dd class="mt-1 text-sm text-gray-900">{{connection.lastTestMessage}}</dd>
      </div>
    </dl>

    <div class="mt-5 flex flex-wrap gap-3">
      <form method="POST" action="/admin/integrations/{{connection.id}}/test">
        <input type="hidden" name="orgId" value="{{activeOrg.id}}">
        <button type="submit" class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700">Test Connection</button>
      </form>
      <form method="POST" action="/admin/integrations/{{connection.id}}/disable">
        <input type="hidden" name="orgId" value="{{activeOrg.id}}">
        <button type="submit" class="rounded-md border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50">Disable</button>
      </form>
    </div>
  </section>

  <section class="rounded-lg border border-amber-200 bg-amber-50 p-5">
    <h2 class="text-lg font-semibold text-amber-950">Rotate Credentials</h2>
    <p class="mt-1 text-sm text-amber-800">Enter replacement credential values. Stored values are never displayed.</p>
    <form method="POST" action="/admin/integrations/{{connection.id}}/rotate" class="mt-4 grid gap-4">
      <input type="hidden" name="orgId" value="{{activeOrg.id}}">
      {{#each provider.credentialForm.fields}}
        <label class="grid gap-1">
          <span class="text-sm font-medium text-gray-700">{{label}}{{#if required}} <span class="text-red-600">*</span>{{/if}}</span>
          <input name="credentials[{{key}}]" type="password" class="rounded-md border border-gray-300 px-3 py-2 text-sm" {{#if required}}required{{/if}}>
          {{#if helpText}}<span class="text-xs text-gray-500">{{helpText}}</span>{{/if}}
        </label>
      {{/each}}
      <div>
        <button type="submit" class="rounded-md bg-amber-600 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-700">Rotate Credentials</button>
      </div>
    </form>
  </section>
</div>
