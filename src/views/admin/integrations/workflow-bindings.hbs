<div class="space-y-6">
  <div>
    <a href="/admin/workflows/{{definition.id}}" class="text-sm font-medium text-indigo-600 hover:text-indigo-700">Back to workflow</a>
    <h1 class="mt-2 text-2xl font-semibold text-gray-900">{{definition.name}} Integrations</h1>
    <p class="mt-1 text-sm text-gray-600">Bind required workflow integration keys to organization connections.</p>
    <p class="mt-1 text-xs text-gray-500">Organization: {{activeOrg.name}}</p>
  </div>

  {{#if query.bound}}<div class="rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">Workflow integration binding saved.</div>{{/if}}
  {{#if query.error}}<div class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{{query.error}}</div>{{/if}}

  <section class="rounded-lg border border-gray-200 bg-white p-5">
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-semibold text-gray-900">Requirements</h2>
      {{#if allRequiredAvailable}}
        <span class="rounded-full bg-green-100 px-3 py-1 text-xs font-medium text-green-800">Required bindings available</span>
      {{else}}
        <span class="rounded-full bg-red-100 px-3 py-1 text-xs font-medium text-red-800">Required bindings missing</span>
      {{/if}}
    </div>

    <div class="mt-4 divide-y divide-gray-100">
      {{#each requirementStatuses}}
        <form method="POST" action="/admin/integrations/workflow-bindings/{{../definition.id}}/{{requirement.key}}" class="grid gap-3 py-4 md:grid-cols-[1fr,2fr,auto] md:items-end">
          <input type="hidden" name="orgId" value="{{../activeOrg.id}}">
          <div>
            <div class="text-sm font-medium text-gray-900">{{requirement.label}}</div>
            <div class="mt-1 font-mono text-xs text-gray-500">{{requirement.key}} · {{requirement.providerKey}} · {{status}}</div>
            {{#if requirement.description}}<p class="mt-1 text-sm text-gray-600">{{requirement.description}}</p>{{/if}}
          </div>
          <label class="grid gap-1">
            <span class="text-sm font-medium text-gray-700">Connection</span>
            <select name="connectionId" class="rounded-md border border-gray-300 px-3 py-2 text-sm" required>
              {{#each ../connections}}
                <option value="{{id}}" {{#if (eq id ../binding.connection.id)}}selected{{/if}}>{{name}} · {{providerKey}} · {{status}}</option>
              {{/each}}
            </select>
          </label>
          <div class="flex items-center gap-3">
            <label class="flex items-center gap-2 text-sm text-gray-700">
              <input type="checkbox" name="isEnabled" class="rounded border-gray-300" {{#if binding.isEnabled}}checked{{/if}}>
              Enabled
            </label>
            <button type="submit" class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700">Bind</button>
          </div>
        </form>
      {{else}}
        <p class="py-6 text-sm text-gray-500">This workflow declares no integration requirements.</p>
      {{/each}}
    </div>
  </section>
</div>
