<div class="space-y-6">
  <div class="flex items-start justify-between gap-4">
    <div>
      <a href="/admin/workflow-operations?orgId={{activeOrg.id}}" class="text-sm font-medium text-indigo-600 hover:text-indigo-700">Back to operations</a>
      <h1 class="mt-2 text-2xl font-semibold text-gray-900">Workflow Schedules</h1>
      <p class="mt-1 text-sm text-gray-600">App-owned Temporal schedules for code-registered workflow definitions.</p>
      <p class="mt-1 text-xs text-gray-500">Organization: {{activeOrg.name}}</p>
    </div>
    <a href="/admin/workflow-operations/schedules/new?orgId={{activeOrg.id}}" class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700">New Schedule</a>
  </div>

  {{#if query.deleted}}
    <div class="rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">Schedule deleted from Temporal and soft-deleted locally.</div>
  {{/if}}

  <section class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
    <form method="GET" action="/admin/workflow-operations/schedules" class="flex flex-wrap items-end gap-3">
      <input type="hidden" name="orgId" value="{{activeOrg.id}}">
      <label class="grid flex-1 min-w-64 gap-1">
        <span class="text-sm font-medium text-gray-700">Search</span>
        <input name="q" value="{{query.q}}" placeholder="Name, Temporal schedule id, cron, workflow..." class="rounded-md border border-gray-300 px-3 py-2 text-sm">
      </label>
      <button type="submit" class="rounded-md border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50">Filter</button>
    </form>
  </section>

  <section class="rounded-lg border border-gray-200 bg-white shadow-sm">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600">Name</th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600">Workflow</th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600">Cron</th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600">Status</th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600">Updated</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          {{#each schedules}}
            <tr>
              <td class="px-4 py-3">
                <div class="text-sm font-medium text-gray-900">{{name}}</div>
                <div class="font-mono text-xs text-gray-500">{{scheduleId}}</div>
              </td>
              <td class="px-4 py-3 text-sm text-gray-700">{{workflowDefinition.name}}</td>
              <td class="px-4 py-3">
                <div class="font-mono text-xs text-gray-700">{{cronExpression}}</div>
                <div class="text-xs text-gray-500">{{timezone}}</div>
              </td>
              <td class="px-4 py-3 text-sm text-gray-700">{{status}}</td>
              <td class="px-4 py-3 text-sm text-gray-700">{{updatedAt}}</td>
              <td class="px-4 py-3 text-right">
                <a href="/admin/workflow-operations/schedules/{{id}}?orgId={{orgId}}" class="text-sm font-medium text-indigo-600 hover:text-indigo-700">Open</a>
              </td>
            </tr>
          {{else}}
            <tr>
              <td colspan="6" class="px-4 py-8 text-center text-sm text-gray-500">No workflow schedules yet.</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </section>
</div>
