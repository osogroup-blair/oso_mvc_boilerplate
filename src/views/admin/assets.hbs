<div class="space-y-6">
  <!-- Page Header -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between space-y-4 md:space-y-0">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 tracking-tight">Media Library</h1>
      <p class="mt-1 text-sm text-gray-500">Upload and manage media files and documents.</p>
    </div>
  </div>

  <!-- Messages -->
  {{#if query.success}}
    <div class="rounded-lg bg-green-50 p-4 border border-green-200">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <p class="text-sm font-medium text-green-800">File uploaded successfully.</p>
        </div>
      </div>
    </div>
  {{/if}}

  {{#if query.deleted}}
    <div class="rounded-lg bg-indigo-50 p-4 border border-indigo-200">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-indigo-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <p class="text-sm font-medium text-indigo-800">File deleted successfully.</p>
        </div>
      </div>
    </div>
  {{/if}}

  {{#if query.error}}
    <div class="rounded-lg bg-red-50 p-4 border border-red-200">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">Upload Error</h3>
          <p class="mt-1 text-sm text-red-700">{{query.error}}</p>
        </div>
      </div>
    </div>
  {{/if}}

  <!-- Upload Area & Media Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
    <!-- Upload Sidebar Panel -->
    <div class="lg:col-span-1">
      <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm space-y-4">
        <h3 class="text-lg font-bold text-gray-900">Upload New Media</h3>
        
        <form action="/admin/assets/upload" method="POST" enctype="multipart/form-data" class="space-y-4">
  <input type="hidden" name="_csrf" value="{{@root.csrfToken}}" />
          <div class="flex justify-center rounded-xl border-2 border-dashed border-gray-300 px-6 pt-5 pb-6 hover:border-indigo-500 transition-colors duration-200">
            <div class="space-y-1 text-center">
              <svg class="mx-auto h-12 w-12 text-gray-400" stroke="currentColor" fill="none" viewBox="0 0 48 48">
                <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <div class="flex text-sm text-gray-600 justify-center">
                <label for="file-upload" class="relative cursor-pointer rounded-md font-semibold text-indigo-600 focus-within:outline-none focus-within:ring-2 focus-within:ring-indigo-500 focus-within:ring-offset-2 hover:text-indigo-500">
                  <span>Upload a file</span>
                  <input id="file-upload" name="file" type="file" required class="sr-only">
                </label>
              </div>
              <p class="text-xs text-gray-500">Images, PDFs, ZIPs up to 10MB</p>
            </div>
          </div>
          
          <div id="file-selected-name" class="text-xs text-gray-500 text-center hidden">
            Selected: <span class="font-semibold text-gray-700"></span>
          </div>

          <button type="submit" class="w-full inline-flex justify-center items-center px-4 py-2 border border-transparent text-sm font-semibold rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 shadow-sm transition-colors">
            Upload
          </button>
        </form>
      </div>
    </div>

    <!-- Media Library Grid -->
    <div class="lg:col-span-3 bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
      {{#if assets.length}}
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
          {{#each assets}}
            <div class="group relative flex flex-col justify-between overflow-hidden rounded-xl border border-gray-200 bg-gray-50 hover:shadow-md transition-all duration-200">
              <!-- Preview -->
              <div class="aspect-video w-full flex items-center justify-center bg-gray-200 overflow-hidden">
                {{#if isImage}}
                  <img src="{{url}}" alt="{{filename}}" class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-200">
                {{else}}
                  <!-- Generic document icon -->
                  <svg class="h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                  </svg>
                {{/if}}
              </div>

              <!-- Details -->
              <div class="p-3 bg-white flex flex-col space-y-1">
                <p class="truncate text-xs font-semibold text-gray-700" title="{{filename}}">{{filename}}</p>
                <div class="flex items-center justify-between text-[10px] text-gray-400">
                  <span>{{sizeFormatted}}</span>
                  <span>{{provider}}</span>
                </div>
              </div>

              <!-- Overlays / Actions -->
              <div class="absolute top-2 right-2 flex space-x-1 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                <!-- Copy link -->
                <button onclick="navigator.clipboard.writeText(window.location.origin + '{{url}}'); alert('URL copied!');" class="p-1.5 rounded-lg bg-white/90 shadow hover:bg-white text-gray-700 transition-colors">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
                  </svg>
                </button>

                <!-- Delete -->
                <form action="/admin/assets/delete/{{id}}" method="POST" onsubmit="return confirm('Are you sure you want to delete this file?');" class="inline">
  <input type="hidden" name="_csrf" value="{{@root.csrfToken}}" />
                  <button type="submit" class="p-1.5 rounded-lg bg-red-50/90 shadow hover:bg-red-500 hover:text-white text-red-600 transition-colors">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                  </button>
                </form>
              </div>
            </div>
          {{/each}}
        </div>
      {{else}}
        <div class="text-center py-12 text-gray-500">
          <svg class="mx-auto h-12 w-12 text-gray-300" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 13.5h3.86a2.25 2.25 0 012.008 1.24l.885 1.77a2.25 2.25 0 002.007 1.24h1.98a2.25 2.25 0 002.007-1.24l.885-1.77a2.25 2.25 0 012.007-1.24h3.86m-18 0h18" />
          </svg>
          <p class="mt-2 text-sm">No media assets found. Upload some files to start your library.</p>
        </div>
      {{/if}}
    </div>
  </div>
</div>

<script>
  // Simple UI helper to show chosen filename in upload form
  document.getElementById('file-upload').addEventListener('change', function(e) {
    const fileName = e.target.files[0]?.name;
    const infoDiv = document.getElementById('file-selected-name');
    if (fileName) {
      infoDiv.querySelector('span').textContent = fileName;
      infoDiv.classList.remove('hidden');
    } else {
      infoDiv.classList.add('hidden');
    }
  });
</script>
