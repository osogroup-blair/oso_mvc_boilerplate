<div class="max-w-4xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
  <div class="mb-8">
    <h1 class="text-2xl font-bold text-gray-900">Site Settings</h1>
    <p class="mt-1 text-sm text-gray-500">Manage global application configuration.</p>
  </div>

  {{#if messages.success}}
    <div class="mb-6 rounded-md bg-green-50 p-4 border border-green-200">
      <div class="flex">
        <div class="ml-3">
          <p class="text-sm font-medium text-green-800">{{messages.success}}</p>
        </div>
      </div>
    </div>
  {{/if}}
  
  {{#if messages.error}}
    <div class="mb-6 rounded-md bg-red-50 p-4 border border-red-200">
      <div class="flex">
        <div class="ml-3">
          <p class="text-sm font-medium text-red-800">{{messages.error}}</p>
        </div>
      </div>
    </div>
  {{/if}}

  <form action="/admin/settings" method="POST" class="space-y-6">
    {{#each sections}}
      <div class="bg-white shadow-sm ring-1 ring-gray-900/5 sm:rounded-xl">
        <div class="border-b border-gray-100 px-4 py-4 sm:px-8">
          <h2 class="text-base font-semibold leading-7 text-gray-900">{{this.name}}</h2>
        </div>
        <div class="px-4 py-6 sm:p-8">
          <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-2">
            {{#each this.fields}}
              <div class="sm:col-span-1">
                {{> settings-field this publishedPages=../publishedPages}}
              </div>
            {{/each}}
          </div>
        </div>
      </div>
    {{/each}}

    <div class="flex items-center justify-end gap-x-6 bg-gray-50 border border-gray-100 rounded-xl px-4 py-4 sm:px-8 shadow-sm">
      <button type="submit" class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
        Save Settings
      </button>
    </div>
  </form>
</div>
