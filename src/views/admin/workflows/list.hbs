<div class="space-y-6">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold text-gray-900">Workflows</h1>
      <p class="mt-1 text-sm text-gray-600">Code-registered workflow definitions available in this deployment.</p>
    </div>
  </div>

  {{#if query.updated}}
    <div class="rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">Workflow updated.</div>
  {{/if}}

  <div class="overflow-hidden rounded-lg border border-gray-200 bg-white">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600">Name</th>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600">Key</th>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600">Version</th>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600">Queue</th>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600">Status</th>
          <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-gray-600">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 bg-white">
        {{#each definitions}}
          <tr>
            <td class="px-4 py-3">
              <div class="font-medium text-gray-900">{{name}}</div>
              <div class="text-xs text-gray-500">{{category}}</div>
            </td>
            <td class="px-4 py-3 font-mono text-xs text-gray-700">{{key}}</td>
            <td class="px-4 py-3 text-sm text-gray-700">{{contractVersion}}</td>
            <td class="px-4 py-3 font-mono text-xs text-gray-700">{{defaultTaskQueue}}</td>
            <td class="px-4 py-3">
              {{#if isEnabled}}
                <span class="rounded-full bg-green-100 px-2 py-1 text-xs font-medium text-green-800">Enabled</span>
              {{else}}
                <span class="rounded-full bg-gray-100 px-2 py-1 text-xs font-medium text-gray-700">Disabled</span>
              {{/if}}
            </td>
            <td class="px-4 py-3 text-right">
              <a href="/admin/workflows/{{id}}" class="text-sm font-medium text-indigo-600 hover:text-indigo-700">Configure</a>
            </td>
          </tr>
        {{else}}
          <tr>
            <td colspan="6" class="px-4 py-10 text-center text-sm text-gray-500">No workflow definitions have been registered.</td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
