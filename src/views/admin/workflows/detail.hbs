<div class="space-y-6">
  <div>
    <a href="/admin/workflows" class="text-sm font-medium text-indigo-600 hover:text-indigo-700">Back to workflows</a>
    <h1 class="mt-2 text-2xl font-semibold text-gray-900">{{definition.name}}</h1>
    <p class="mt-1 text-sm text-gray-600">{{definition.key}} · {{definition.workflowType}} · v{{definition.contractVersion}}</p>
  </div>

  {{#if query.error}}
    <div class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{{query.error}}</div>
  {{/if}}
  {{#if query.updated}}
    <div class="rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">Workflow metadata updated.</div>
  {{/if}}
  {{#if query.policyUpdated}}
    <div class="rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">Workflow role policy updated.</div>
  {{/if}}

  <section class="rounded-lg border border-gray-200 bg-white p-5">
    <h2 class="text-lg font-semibold text-gray-900">Admin Metadata</h2>
    <form method="POST" action="/admin/workflows/{{definition.id}}" class="mt-4 grid gap-4">
      <label class="grid gap-1">
        <span class="text-sm font-medium text-gray-700">Name</span>
        <input name="name" value="{{definition.name}}" class="rounded-md border border-gray-300 px-3 py-2 text-sm" required>
      </label>

      <label class="grid gap-1">
        <span class="text-sm font-medium text-gray-700">Description</span>
        <textarea name="description" rows="3" class="rounded-md border border-gray-300 px-3 py-2 text-sm">{{definition.description}}</textarea>
      </label>

      <div class="grid gap-4 md:grid-cols-2">
        <label class="grid gap-1">
          <span class="text-sm font-medium text-gray-700">Category</span>
          <input name="category" value="{{definition.category}}" class="rounded-md border border-gray-300 px-3 py-2 text-sm">
        </label>
        <label class="grid gap-1">
          <span class="text-sm font-medium text-gray-700">Icon</span>
          <input name="icon" value="{{definition.icon}}" class="rounded-md border border-gray-300 px-3 py-2 text-sm">
        </label>
      </div>

      <label class="flex items-center gap-2 text-sm font-medium text-gray-700">
        <input type="checkbox" name="isEnabled" class="rounded border-gray-300" {{#if definition.isEnabled}}checked{{/if}}>
        Enabled in catalog
      </label>

      <label class="grid gap-1">
        <span class="text-sm font-medium text-gray-700">Presentation JSON</span>
        <textarea name="presentation" rows="6" class="font-mono rounded-md border border-gray-300 px-3 py-2 text-xs">{{presentationJson}}</textarea>
      </label>

      <div>
        <button type="submit" class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700">Save Metadata</button>
      </div>
    </form>
  </section>

  <section class="rounded-lg border border-gray-200 bg-white p-5">
    <h2 class="text-lg font-semibold text-gray-900">Role Capabilities</h2>
    <form method="POST" action="/admin/workflows/{{definition.id}}/policy" class="mt-4">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600">Role</th>
              {{#each capabilities}}
                <th class="px-4 py-3 text-center text-xs font-semibold uppercase tracking-wide text-gray-600">{{this}}</th>
              {{/each}}
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {{#each roleRows}}
              <tr>
                <td class="px-4 py-3 text-sm font-medium text-gray-900">{{role.name}}</td>
                {{#each capabilities}}
                  <td class="px-4 py-3 text-center">
                    <input type="checkbox" name="policy[{{../role.id}}][{{value}}]" {{#if checked}}checked{{/if}} class="rounded border-gray-300">
                  </td>
                {{/each}}
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      <div class="mt-4">
        <button type="submit" class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700">Save Policy</button>
      </div>
    </form>
  </section>

  <section class="rounded-lg border border-gray-200 bg-white p-5">
    <div class="flex items-center justify-between gap-4">
      <h2 class="text-lg font-semibold text-gray-900">Integration Requirements</h2>
      <a href="/admin/integrations/workflow-bindings/{{definition.id}}" class="text-sm font-medium text-indigo-600 hover:text-indigo-700">Configure bindings</a>
    </div>
    <div class="mt-3 divide-y divide-gray-100">
      {{#each definition.integrationRequirements}}
        <div class="py-3">
          <div class="text-sm font-medium text-gray-900">{{label}}</div>
          <div class="font-mono text-xs text-gray-500">{{key}} · {{providerKey}}</div>
          {{#if description}}<p class="mt-1 text-sm text-gray-600">{{description}}</p>{{/if}}
        </div>
      {{else}}
        <p class="text-sm text-gray-500">This workflow declares no integration requirements yet.</p>
      {{/each}}
    </div>
  </section>
</div>
