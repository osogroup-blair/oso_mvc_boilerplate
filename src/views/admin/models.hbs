<div class="mb-8">
  <h1 class="text-3xl font-bold text-gray-900 tracking-tight">Database Models</h1>
  <p class="text-sm text-gray-500 mt-1">Manage all internal schemas for this application.</p>
</div>

<!-- Tabs -->
<div class="mb-8 border-b border-gray-200">
  <nav class="-mb-px flex space-x-4 items-center" aria-label="Tabs" id="models-tabs">
    <button data-tab="application" id="tab-application" class="whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm border-indigo-500 text-indigo-600">
      Application Models
    </button>
    <span class="text-gray-300 font-light mb-1">|</span>
    <button data-tab="system" id="tab-system" class="whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300">
      System Models
    </button>
    <span class="text-gray-300 font-light mb-1">|</span>
    <button data-tab="diagnostics" id="tab-diagnostics" class="whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300">
      Diagnostics
    </button>
  </nav>
</div>

<!-- Application Models Tab Content -->
<div id="content-application" class="tab-content block">
  <p class="text-sm text-gray-500 mb-6">Bespoke resources specific to this application's custom functionality.</p>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 mb-12">
    {{#each applicationSchemas}}
      <a href="/admin/{{this.key}}" class="block bg-white rounded-lg border border-indigo-100 p-5 hover:border-indigo-400 hover:shadow-md transition flex items-center justify-between">
        <div>
          <span class="text-lg font-medium text-gray-900 block">{{this.label}}</span>
          <span class="text-xs text-gray-500 mt-1 block">Manage {{this.label}} data</span>
        </div>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800">
          {{this.count}} records
        </span>
      </a>
    {{/each}}
  </div>
</div>

<!-- System Models Tab Content -->
<div id="content-system" class="tab-content hidden">
  <p class="text-sm text-gray-500 mb-6">Core system resources for administration and boilerplate configuration.</p>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 mb-12">
    {{#each systemSchemas}}
      <a href="/admin/{{this.key}}" class="block bg-gray-50 rounded-lg border border-gray-200 p-5 hover:border-gray-400 hover:bg-white transition flex items-center justify-between">
        <div>
          <span class="text-lg font-medium text-gray-700 block">{{this.label}}</span>
          <span class="text-xs text-gray-500 mt-1 block">Core system schema</span>
        </div>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-200 text-gray-800">
          {{this.count}} records
        </span>
      </a>
    {{/each}}
  </div>
</div>

<!-- Diagnostics Tab Content -->
<div id="content-diagnostics" class="tab-content hidden">
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <a href="/admin/logs/audit" class="block bg-white rounded-lg border border-gray-200 p-5 hover:border-blue-400 transition">
      <span class="text-lg font-medium text-gray-800">Audit Log</span>
      <p class="text-sm text-gray-500 mt-1">Record of all mutations.</p>
    </a>
    <a href="/admin/logs/diagnostics" class="block bg-white rounded-lg border border-gray-200 p-5 hover:border-blue-400 transition">
      <span class="text-lg font-medium text-gray-800">Diagnostics</span>
      <p class="text-sm text-gray-500 mt-1">Live requests &amp; health.</p>
    </a>
  </div>
</div>

<script nonce="{{@root.cspNonce}}">
  function switchTab(tabId) {
    // Hide all contents
    document.querySelectorAll('.tab-content').forEach(el => {
      el.classList.add('hidden');
      el.classList.remove('block');
    });
    
    // Show selected content
    document.getElementById('content-' + tabId).classList.remove('hidden');
    document.getElementById('content-' + tabId).classList.add('block');

    // Reset all tabs
    const inactiveClasses = ['border-transparent', 'text-gray-500', 'hover:text-gray-700', 'hover:border-gray-300'];
    const activeClasses = ['border-indigo-500', 'text-indigo-600'];
    
    document.querySelectorAll('#models-tabs button').forEach(el => {
      el.classList.remove(...activeClasses);
      el.classList.add(...inactiveClasses);
    });

    // Activate selected tab
    const activeTab = document.getElementById('tab-' + tabId);
    activeTab.classList.remove(...inactiveClasses);
    activeTab.classList.add(...activeClasses);
  }
</script>
