<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{title}} · Admin</title>
  <link rel="stylesheet" href="/css/app.css" />
  <style>
    /* ── Sidebar nav link styles ──────────────────────────── */
    .admin-nav-link {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      padding: 0.5rem 0.75rem;
      border-radius: 0.5rem;
      font-size: 0.875rem;
      font-weight: 500;
      color: rgb(156 163 175);
      transition: background-color 0.15s, color 0.15s;
      text-decoration: none;
    }
    .admin-nav-link:hover {
      background-color: rgba(55, 65, 81, 0.6);
      color: #fff;
    }
    .admin-nav-link.active {
      background-color: rgba(79, 70, 229, 0.2);
      color: #fff;
    }
    .admin-nav-link.active .nav-icon { color: rgb(129 140 248); }
    .nav-icon {
      width: 1.125rem;
      height: 1.125rem;
      flex-shrink: 0;
      color: rgb(107 114 128);
    }
    .admin-nav-link:hover .nav-icon { color: rgb(209 213 219); }
    .nav-group-label {
      font-size: 0.6875rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgb(107 114 128);
      padding: 0 0.75rem;
      margin-bottom: 0.375rem;
    }

    /* ── Layout shell (immune to Tailwind purge) ─────────── */
    .admin-shell {
      display: flex;
      height: 100vh;
      overflow: hidden;
    }
    .admin-content-col {
      display: flex;
      flex-direction: column;
      flex: 1 1 0%;
      min-width: 0;
      overflow: hidden;
    }
    .admin-topbar {
      display: flex;
      align-items: center;
      gap: 1rem;
      background: #fff;
      border-bottom: 1px solid #e5e7eb;
      padding: 0.75rem 1.5rem;
      flex-shrink: 0;
    }
    .admin-main {
      flex: 1 1 0%;
      overflow-y: auto;
      padding: 1.5rem 2rem;
    }

    /* ── Mobile sidebar (off-canvas on small screens) ─────── */
    #sidebar-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      z-index: 39;
    }
    #sidebar-overlay.active { display: block; }

    .sidebar-hamburger {
      display: none;
      align-items: center;
      justify-content: center;
      padding: 0.375rem;
      border-radius: 0.375rem;
      color: #6b7280;
      background: none;
      border: none;
      cursor: pointer;
    }
    .sidebar-hamburger:hover { background: #f3f4f6; }

    @media (max-width: 1023px) {
      #admin-sidebar {
        position: fixed;
        top: 0;
        bottom: 0;
        left: 0;
        z-index: 40;
        transform: translateX(-100%);
        transition: transform 0.2s ease-in-out;
      }
      #admin-sidebar.open { transform: translateX(0); }
      .sidebar-hamburger { display: flex; }
    }
  </style>
</head>
<body class="bg-gray-100 text-gray-900 antialiased">

{{#unless hideNav}}
  {{!-- Mobile overlay --}}
  <div id="sidebar-overlay" data-sidebar="close"></div>

  <div class="admin-shell">

    {{!-- Left Sidebar --}}
    {{> admin-sidebar}}

    {{!-- Right: top bar + content --}}
    <div class="admin-content-col">

      {{!-- Top bar: hamburger (mobile) + breadcrumb --}}
      <header class="admin-topbar">
        <button class="sidebar-hamburger" data-sidebar="open" aria-label="Open navigation">
          <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
        </button>

        {{!-- Breadcrumb --}}
        <div style="display:flex;align-items:center;gap:0.5rem;font-size:0.875rem;">
          <a href="/admin" style="font-weight:500;color:#6b7280;text-decoration:none;">Admin</a>
          {{#if title}}
            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="#d1d5db" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
            <span style="font-weight:600;color:#111827;">{{title}}</span>
          {{/if}}
        </div>
      </header>

      {{!-- Page content --}}
      <main class="admin-main">
        {{{body}}}
      </main>

    </div>
  </div>
{{else}}
  {{!-- Login page — no shell, just centred content --}}
  <main>
    {{{body}}}
  </main>
{{/unless}}

<script src="/js/admin.js"></script>
<script nonce="{{@root.cspNonce}}">
  function openSidebar() {
    document.getElementById('admin-sidebar').classList.add('open');
    document.getElementById('sidebar-overlay').classList.add('active');
  }
  function closeSidebar() {
    document.getElementById('admin-sidebar').classList.remove('open');
    document.getElementById('sidebar-overlay').classList.remove('active');
  }
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeSidebar();
  });
</script>
<script src="/js/ui-actions.js" defer></script>
</body>
</html>
