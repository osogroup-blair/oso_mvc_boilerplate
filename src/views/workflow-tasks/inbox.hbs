<main class="mx-auto max-w-6xl px-4 py-10">
  <div class="mb-8 flex flex-wrap items-start justify-between gap-4">
    <div>
      <a href="/workflows?orgId={{activeOrg.id}}" class="text-sm font-medium text-indigo-600 hover:text-indigo-700">Back to workflows</a>
      <h1 class="mt-2 text-3xl font-semibold text-gray-900">Workflow Tasks</h1>
      <p class="mt-2 text-sm text-gray-600">Open tasks assigned to you or available to your role in {{activeOrg.name}}.</p>
    </div>
  </div>

  <div class="overflow-hidden rounded-lg border border-gray-200 bg-white">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600">Task</th>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600">Workflow</th>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600">Status</th>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-600">Opened</th>
          <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-gray-600">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        {{#each tasks}}
          <tr>
            <td class="px-4 py-3">
              <div class="font-medium text-gray-900">{{title}}</div>
              {{#if assignedUser}}<div class="text-xs text-gray-500">Assigned to {{assignedUser.name}}</div>{{/if}}
            </td>
            <td class="px-4 py-3 text-sm text-gray-700">{{workflowExecution.workflowDefinition.name}}</td>
            <td class="px-4 py-3 text-sm text-gray-700">{{status}}</td>
            <td class="px-4 py-3 text-sm text-gray-700">{{openedAt}}</td>
            <td class="px-4 py-3 text-right">
              <a href="/workflow-tasks/{{id}}?orgId={{../activeOrg.id}}" class="text-sm font-medium text-indigo-600 hover:text-indigo-700">Open</a>
            </td>
          </tr>
        {{else}}
          <tr>
            <td colspan="5" class="px-4 py-10 text-center text-sm text-gray-500">No open workflow tasks.</td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</main>
