<main class="mx-auto max-w-3xl px-4 py-10">
  <div class="mb-8">
    <a href="/workflows?orgId={{activeOrg.id}}" class="text-sm font-medium text-indigo-600 hover:text-indigo-700">Back to catalog</a>
    <h1 class="mt-2 text-3xl font-semibold text-gray-900">{{definition.name}}</h1>
    {{#if definition.description}}<p class="mt-2 text-sm text-gray-600">{{definition.description}}</p>{{/if}}
    <p class="mt-2 text-xs text-gray-500">Organization: {{activeOrg.name}}</p>
  </div>

  {{#if query.error}}
    <div class="mb-6 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{{query.error}}</div>
  {{/if}}

  {{#if integrationStatuses}}
    <section class="mb-6 rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
      <h2 class="text-lg font-semibold text-gray-900">Required Integrations</h2>
      <div class="mt-3 divide-y divide-gray-100">
        {{#each integrationStatuses}}
          <div class="flex items-start justify-between gap-4 py-3">
            <div>
              <div class="text-sm font-medium text-gray-900">{{requirement.label}}</div>
              <div class="mt-1 font-mono text-xs text-gray-500">{{requirement.key}} · {{requirement.providerKey}}</div>
              {{#if binding.connection.name}}<p class="mt-1 text-sm text-gray-600">Bound to {{binding.connection.name}}</p>{{/if}}
              {{#unless available}}<p class="mt-1 text-sm text-red-700">{{reason}}</p>{{/unless}}
            </div>
            <span class="rounded-full px-3 py-1 text-xs font-medium {{#if available}}bg-green-100 text-green-800{{else}}bg-red-100 text-red-800{{/if}}">{{status}}</span>
          </div>
        {{/each}}
      </div>
      {{#unless allRequiredIntegrationsAvailable}}
        <p class="mt-3 text-sm text-red-700">An administrator must bind active connections before this workflow can start.</p>
      {{/unless}}
    </section>
  {{/if}}

  <section class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
    <h2 class="text-lg font-semibold text-gray-900">Start Workflow</h2>
    <form method="POST" action="/workflows/{{definition.slug}}/start" class="mt-5 grid gap-4">
      <input type="hidden" name="operationId" value="{{operationId}}">
      <input type="hidden" name="orgId" value="{{activeOrg.id}}">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">

      {{#each registration.startForm.fields}}
        <label class="grid gap-1">
          <span class="text-sm font-medium text-gray-700">{{label}}{{#if required}} <span class="text-red-600">*</span>{{/if}}</span>
          {{#if (eq type "textarea")}}
            <textarea name="{{key}}" rows="4" placeholder="{{placeholder}}" class="rounded-md border border-gray-300 px-3 py-2 text-sm">{{defaultValue}}</textarea>
          {{else}}
            {{#if (eq type "select")}}
              <select name="{{key}}" class="rounded-md border border-gray-300 px-3 py-2 text-sm">
                {{#each options}}
                  <option value="{{value}}">{{label}}</option>
                {{/each}}
              </select>
            {{else}}
              {{#if (eq type "boolean")}}
                <input type="checkbox" name="{{key}}" value="true" class="h-4 w-4 rounded border-gray-300">
              {{else}}
                <input name="{{key}}" type="{{#if (eq type "number")}}number{{else}}{{type}}{{/if}}" value="{{defaultValue}}" placeholder="{{placeholder}}" class="rounded-md border border-gray-300 px-3 py-2 text-sm">
              {{/if}}
            {{/if}}
          {{/if}}
          {{#if helpText}}<span class="text-xs text-gray-500">{{helpText}}</span>{{/if}}
        </label>
      {{else}}
        <p class="text-sm text-gray-500">This workflow does not require start input.</p>
      {{/each}}

      <div class="pt-2">
        {{#if canStart}}
          <button type="submit" class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700">Start Workflow</button>
        {{else}}
          {{#if allRequiredIntegrationsAvailable}}
            <span class="text-sm text-gray-500">Your role can view this workflow but cannot start it.</span>
          {{else}}
            <span class="text-sm text-gray-500">This workflow cannot start until required integrations are available.</span>
          {{/if}}
        {{/if}}
      </div>
    </form>
  </section>
</main>
