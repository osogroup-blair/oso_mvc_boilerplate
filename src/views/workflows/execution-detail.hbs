{{#if execution.syncErrorCode}}<div role="alert">State summary could not be refreshed. Engine status and summary freshness are separate.</div>{{/if}}
<main class="mx-auto max-w-5xl px-4 py-10">
  <div class="mb-8">
    <a href="/workflows/executions?orgId={{activeOrg.id}}" class="text-sm font-medium text-indigo-600 hover:text-indigo-700">Back to executions</a>
    <h1 class="mt-2 text-3xl font-semibold text-gray-900">{{execution.workflowDefinition.name}}</h1>
    <p class="mt-2 font-mono text-xs text-gray-500">{{execution.workflowId}}</p>
  </div>

  {{#if query.started}}
    <div class="mb-6 rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">Workflow started.</div>
  {{/if}}
  {{#if query.cancelled}}
    <div class="mb-6 rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">Cancel requested.</div>
  {{/if}}

  <div class="grid gap-4 md:grid-cols-3">
    <section class="rounded-lg border border-gray-200 bg-white p-5">
      <div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Status</div>
      <div class="mt-2 text-xl font-semibold text-gray-900">{{execution.status}}</div>
    </section>
    <section class="rounded-lg border border-gray-200 bg-white p-5">
      <div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Business Key</div>
      <div class="mt-2 text-sm text-gray-900">{{execution.businessKey}}</div>
    </section>
    <section class="rounded-lg border border-gray-200 bg-white p-5">
      <div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Run ID</div>
      <div class="mt-2 break-all font-mono text-xs text-gray-700">{{execution.runId}}</div>
    </section>
  </div>

  <div class="mt-6 flex flex-wrap gap-3">
    <form method="post" action="/workflows/executions/{{execution.id}}/refresh?orgId={{activeOrg.id}}">
      <input type="hidden" name="_csrf" value="{{@root.csrfToken}}" />
      <button type="submit" class="rounded-md border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50">Refresh JSON</button>
    </form>
    <form method="POST" action="/workflows/executions/{{execution.id}}/cancel" class="m-0">
      <input type="hidden" name="orgId" value="{{activeOrg.id}}">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <button type="submit" class="rounded-md border border-red-300 px-4 py-2 text-sm font-semibold text-red-700 hover:bg-red-50">Cancel</button>
    </form>
  </div>

  <div class="mt-8 grid gap-6 md:grid-cols-2">
    <section class="rounded-lg border border-gray-200 bg-white p-5">
      <h2 class="text-lg font-semibold text-gray-900">Input Summary</h2>
      <pre class="mt-3 overflow-x-auto rounded-md bg-gray-950 p-4 text-xs text-gray-100">{{inputSummaryJson}}</pre>
    </section>
    <section class="rounded-lg border border-gray-200 bg-white p-5">
      <h2 class="text-lg font-semibold text-gray-900">State Summary</h2>
      <pre class="mt-3 overflow-x-auto rounded-md bg-gray-950 p-4 text-xs text-gray-100">{{stateSummaryJson}}</pre>
    </section>
  </div>

  {{#if errorJson}}
    <section class="mt-6 rounded-lg border border-red-200 bg-white p-5">
      <h2 class="text-lg font-semibold text-gray-900">Error</h2>
      <pre class="mt-3 overflow-x-auto rounded-md bg-red-950 p-4 text-xs text-red-50">{{errorJson}}</pre>
    </section>
  {{/if}}
</main>
