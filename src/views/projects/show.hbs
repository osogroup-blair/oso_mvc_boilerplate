{{!-- projects/show.hbs — Project detail + task list.
     Demonstrates:
       - Controller pre-fetches all data (project + tasks + tags) — view never queries.
       - Task list uses the task-row partial for each row.
       - Tag badges are rendered from the eager-loaded M2M taskTags relation. --}}
<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

  {{!-- Breadcrumb --}}
  <nav class="mb-6 text-sm text-gray-400">
    <a href="/projects" class="hover:text-indigo-600">Projects</a>
    <span class="mx-2">/</span>
    <span class="text-gray-700">{{project.name}}</span>
  </nav>

  {{!-- Project header --}}
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 mb-8">
    <div class="flex items-start justify-between gap-4">
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-3 mb-1">
          {{> projects/status-badge status=project.status}}
        </div>
        <h1 class="text-2xl font-bold text-gray-900 mt-2">{{project.name}}</h1>
        {{#if project.description}}
          <p class="mt-2 text-gray-500 text-sm">{{project.description}}</p>
        {{/if}}
        <div class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-xs text-gray-400">
          <span>Owner: <strong class="text-gray-700">{{project.owner.name}}</strong></span>
          <span>Created: <strong class="text-gray-700">{{project.createdAt}}</strong></span>
        </div>
      </div>

      {{!-- Edit / Delete — only shown to owner --}}
      {{#if canEdit}}
        <div class="flex items-center gap-2 shrink-0">
          <a href="/projects/{{project.id}}/edit"
             class="px-3 py-1.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50">
            Edit
          </a>
          <form method="POST" action="/projects/{{project.id}}/delete"
                data-confirm="Delete this project?">
  <input type="hidden" name="_csrf" value="{{@root.csrfToken}}" />
  <input type="hidden" name="operationId" value="{{@root.operationId}}" />
            <button type="submit"
                    class="px-3 py-1.5 text-sm font-medium text-red-600 bg-white border border-red-200 rounded-md hover:bg-red-50">
              Delete
            </button>
          </form>
        </div>
      {{/if}}
    </div>
  </div>

  {{!-- Tasks table --}}
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
      <h2 class="text-base font-semibold text-gray-900">
        Tasks <span class="text-gray-400 font-normal text-sm">({{taskCount}})</span>
      </h2>
    </div>

    {{#if tasks.length}}
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-100">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Title</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Priority</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tags</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Due</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-100">
            {{#each tasks}}
              {{> projects/task-row this}}
            {{/each}}
          </tbody>
        </table>
      </div>
    {{else}}
      <div class="px-6 py-12 text-center text-gray-400 text-sm">
        No tasks yet for this project.
      </div>
    {{/if}}
  </div>

  {{!-- Admin shortcut --}}
  <div class="mt-6 text-center text-xs text-gray-400">
    Manage tasks and tags in the
    <a href="/admin/task" class="text-indigo-500 hover:underline">Admin → Tasks</a>
    panel.
  </div>
</div>
