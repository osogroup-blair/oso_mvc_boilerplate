{{!-- projects/form.hbs — Shared create/edit form.
     Demonstrates: single template serves both create and edit (controller sets
     isEdit flag + pre-fills project fields). Standard HTML form POST with redirect. --}}
<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

  {{!-- Breadcrumb --}}
  <nav class="mb-6 text-sm text-gray-400">
    <a href="/projects" class="hover:text-indigo-600">Projects</a>
    {{#if isEdit}}
      <span class="mx-2">/</span>
      <a href="/projects/{{project.id}}" class="hover:text-indigo-600">{{project.name}}</a>
    {{/if}}
    <span class="mx-2">/</span>
    <span class="text-gray-700">{{#if isEdit}}Edit{{else}}New Project{{/if}}</span>
  </nav>

  <div class="bg-white rounded-xl border border-gray-200 shadow-sm">
    <div class="px-6 py-4 border-b border-gray-100">
      <h1 class="text-lg font-semibold text-gray-900">
        {{#if isEdit}}Edit project{{else}}New project{{/if}}
      </h1>
    </div>

    {{!-- Validation errors from Zod (flashed back by controller) --}}
    {{#if errors}}
      <div class="px-6 pt-4">
        <div class="bg-red-50 border border-red-200 rounded-md px-4 py-3 text-sm text-red-700">
          <ul class="list-disc list-inside space-y-1">
            {{#each errors}}
              <li>{{this}}</li>
            {{/each}}
          </ul>
        </div>
      </div>
    {{/if}}

    <form method="POST"
          action="{{#if isEdit}}/projects/{{project.id}}{{else}}/projects{{/if}}"
          class="px-6 py-6 space-y-5">
  <input type="hidden" name="_csrf" value="{{@root.csrfToken}}" />
  {{#unless isEdit}}<input type="hidden" name="operationId" value="{{operationId}}" />{{/unless}}

      {{!-- Name --}}
      <div>
        <label for="name" class="block text-sm font-medium text-gray-700 mb-1">
          Project name <span class="text-red-500">*</span>
        </label>
        <input id="name" name="name" type="text" required
               value="{{project.name}}"
               placeholder="e.g. Alpha Platform"
               class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border">
      </div>

      {{!-- Description --}}
      <div>
        <label for="description" class="block text-sm font-medium text-gray-700 mb-1">Description</label>
        <textarea id="description" name="description" rows="3"
                  placeholder="What is this project about?"
                  class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border">{{project.description}}</textarea>
      </div>

      {{!-- Status — enum select --}}
      <div>
        <label for="status" class="block text-sm font-medium text-gray-700 mb-1">Status</label>
        <select id="status" name="status"
                class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-3 py-2 border bg-white">
          <option value="ACTIVE"    {{#if (eq project.status "ACTIVE")}}selected{{/if}}>Active</option>
          <option value="ON_HOLD"   {{#if (eq project.status "ON_HOLD")}}selected{{/if}}>On Hold</option>
          <option value="COMPLETED" {{#if (eq project.status "COMPLETED")}}selected{{/if}}>Completed</option>
          <option value="ARCHIVED"  {{#if (eq project.status "ARCHIVED")}}selected{{/if}}>Archived</option>
        </select>
      </div>

      {{!-- Actions --}}
      <div class="flex items-center justify-between pt-2 border-t border-gray-100">
        <a href="{{#if isEdit}}/projects/{{project.id}}{{else}}/projects{{/if}}"
           class="text-sm text-gray-500 hover:text-gray-700">Cancel</a>
        <button type="submit"
                class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
          {{#if isEdit}}Save changes{{else}}Create project{{/if}}
        </button>
      </div>
    </form>
  </div>
</div>
