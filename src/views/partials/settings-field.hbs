<div class="space-y-2">
  <label for="{{this.key}}" class="block text-sm font-medium text-gray-700">
    {{this.label}}
  </label>
  
  {{#if this.isBoolean}}
    <div class="flex items-center">
      <input 
        type="checkbox" 
        id="{{this.key}}" 
        name="{{this.key}}" 
        value="true"
        {{#if this.isCheckboxChecked}}checked{{/if}}
        class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500"
      />
      <span class="ml-2 text-sm text-gray-500">{{this.help}}</span>
    </div>
  {{else if this.isTextarea}}
    <textarea 
      id="{{this.key}}" 
      name="{{this.key}}" 
      rows="4" 
      class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500 sm:text-sm"
    >{{this.value}}</textarea>
    <p class="mt-1 text-xs text-gray-500">{{this.help}}</p>
  {{else if this.isSelect}}
    <select 
      id="{{this.key}}" 
      name="{{this.key}}" 
      class="mt-1 block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500 sm:text-sm"
    >
      {{#if (eq this.key "HOME_PAGE_SLUG")}}
        {{#each @root.publishedPages}}
          <option value="{{this.slug}}" {{#if (eq this.slug ../value)}}selected{{/if}}>{{this.title}} ({{this.slug}})</option>
        {{/each}}
      {{else}}
        {{#each this.options}}
          <option value="{{this}}" {{#if (eq this ../value)}}selected{{/if}}>{{this}}</option>
        {{/each}}
      {{/if}}
    </select>
    <p class="mt-1 text-xs text-gray-500">{{this.help}}</p>
  {{else if this.isNumber}}
    <input 
      type="number" 
      id="{{this.key}}" 
      name="{{this.key}}" 
      value="{{this.value}}"
      class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500 sm:text-sm"
    />
    <p class="mt-1 text-xs text-gray-500">{{this.help}}</p>
  {{else}}
    <input 
      type="{{this.type}}" 
      id="{{this.key}}" 
      name="{{this.key}}" 
      value="{{this.value}}"
      class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500 sm:text-sm"
    />
    <p class="mt-1 text-xs text-gray-500">{{this.help}}</p>
  {{/if}}
</div>
