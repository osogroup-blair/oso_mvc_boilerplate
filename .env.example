# ─── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ─── Database ──────────────────────────────────────────
# Matches docker-compose.yml. Change if you use your own Postgres.
DATABASE_URL="postgresql://boilerplate:boilerplate@localhost:5436/boilerplate?schema=public"

# ─── Temporal ──────────────────────────────────────────
# Local self-hosted Temporal is started with: npm run temporal:up
TEMPORAL_ADDRESS=localhost:7243
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=oso-workflows
TEMPORAL_WORKER_IDENTITY=oso-temporal-worker
TEMPORAL_TLS_ENABLED=false
TEMPORAL_UI_BASE_URL=http://localhost:8243

# ─── Integration Credential Encryption ─────────────────
# Development placeholder only. Generate and rotate real production key
# material through your secret manager. Keep previous key versions in the
# JSON key ring until all stored IntegrationConnection rows have been rotated.
INTEGRATION_CREDENTIAL_KEY_VERSION=dev-v1
INTEGRATION_CREDENTIAL_KEY="dev-only-integration-credential-key-00000000"
INTEGRATION_CREDENTIAL_KEY_RING={}

# ─── Auth ──────────────────────────────────────────────
# Generate a real secret in production: openssl rand -hex 32
JWT_SECRET="dev-only-change-me-in-production-0000000000000000"
SESSION_TTL_HOURS=24
