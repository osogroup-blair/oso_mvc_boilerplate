# ─── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ─── Database ──────────────────────────────────────────
# Matches docker-compose.yml. Change if you use your own Postgres.
DATABASE_URL="postgresql://boilerplate:boilerplate@localhost:5436/boilerplate?schema=public"

# ─── Temporal ──────────────────────────────────────────
# Local self-hosted Temporal is started with: npm run temporal:up
TEMPORAL_ADDRESS=localhost:7243
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=oso-workflows
TEMPORAL_WORKER_IDENTITY=oso-temporal-worker
TEMPORAL_TLS_ENABLED=false
TEMPORAL_UI_BASE_URL=http://localhost:8244

# ─── Integration Credential Encryption ─────────────────
# Development placeholder only. Generate and rotate real production key
# material through your secret manager. Keep previous key versions in the
# JSON key ring until all stored IntegrationConnection rows have been rotated.
INTEGRATION_CREDENTIAL_KEY_VERSION=dev-v1
INTEGRATION_CREDENTIAL_KEY="dev-only-integration-credential-key-00000000"
INTEGRATION_CREDENTIAL_KEY_RING={}
# Allow integration providers to call loopback/private hosts over http (e.g. the
# local mock webhook server, `npm run mock:webhook`). Never enable in production.
INTEGRATION_ALLOW_PRIVATE_EGRESS=false

# ─── Auth ──────────────────────────────────────────────
# Generate a real secret in production: openssl rand -hex 32
JWT_SECRET="dev-only-change-me-in-production-0000000000000000"
SESSION_TTL_HOURS=24

# Worker drain (milliseconds); deployment termination grace must exceed force + cleanup.
TEMPORAL_SHUTDOWN_GRACE_MS=10000
TEMPORAL_SHUTDOWN_FORCE_MS=30000

# Private files never use STORAGE_LOCAL_DIR or public media URLs.
# Defaults to var/private-assets outside public/. Mount a durable private volume.
# PRIVATE_ASSET_ROOT=/absolute/private/volume
PRIVATE_ASSET_STORE_ID=local-private-v1

# Release Workers may load the exact replayed bundle. Supply both or neither.
# TEMPORAL_WORKFLOW_BUNDLE_PATH=/absolute/release/workflows.js
# TEMPORAL_WORKFLOW_BUNDLE_SHA256=<64 lowercase hex characters>

# TLS is mandatory for NODE_ENV=production and whenever transport credentials
# are configured. Plaintext is supported only for development/test connections.
# TEMPORAL_TLS_CA_PATH=/run/secrets/temporal-ca.pem
# TEMPORAL_TLS_CLIENT_CERT_PATH=/run/secrets/temporal-client.pem
# TEMPORAL_TLS_CLIENT_KEY_PATH=/run/secrets/temporal-client-key.pem
# TEMPORAL_TLS_SERVER_NAME=temporal.example.invalid
# TEMPORAL_API_KEY=<secret supplied by the deployment secret store>

# Bound each resource close after Worker draining (milliseconds).
TEMPORAL_RESOURCE_CLOSE_MS=5000

# Production must encrypt Temporal payloads; retain old key versions for the
# full history/archive/backup retention period, not merely connection rotation.
TEMPORAL_PAYLOAD_ENCRYPTION_ENABLED=false
# Keep true while supported pre-encryption histories remain. Turn off only
# after the reviewed release inventory establishes plaintext is no longer needed.
TEMPORAL_ALLOW_LEGACY_PLAINTEXT=true
